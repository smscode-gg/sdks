{
  "name": "@smscode/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript/JavaScript SDK for the SMSCode virtual number API — rent temporary phone numbers and receive OTP/SMS verification codes programmatically.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "smscode",
    "sms",
    "otp",
    "virtual-number",
    "phone-verification",
    "2fa",
    "sms-verification",
    "api-client",
    "sdk",
    "typescript",
    "receive-sms-online",
    "sms-otp",
    "temporary-phone-number",
    "virtual-phone-number",
    "online-sms"
  ],
  "homepage": "https://smscode.gg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smscode-gg/sdks.git",
    "directory": "packages/sdk-js"
  },
  "bugs": {
    "url": "https://github.com/smscode-gg/sdks/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:types": "openapi-typescript ../../docs/openapi/openapi.yaml -o src/types.gen.ts",
    "check:types": "bun run ../../scripts/check-openapi-types-fresh.ts",
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4",
    "ajv": "^8",
    "ajv-formats": "^3",
    "eslint": "^9.18.0",
    "globals": "^17.7.0",
    "js-yaml": "^4",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.5.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
